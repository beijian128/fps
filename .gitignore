.client2/

# Build outputs
joltgo/build/
joltgo/joltgo.exe
joltgo/joltgo.exe~
joltgo/libjolt_c.dll
joltgo/*.log

# Local cluster infra data (etcd)
joltgo/deploy/etcd-data/

# Local cluster infra data (Redis: accounts + credentials -- never wiped, see deploy/README.md)
joltgo/deploy/redis-data/

