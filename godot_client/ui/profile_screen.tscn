layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="Rows" type="VBoxContainer" parent="Columns/Identity"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Back" type="Button" parent="Columns/Identity/Rows"]
