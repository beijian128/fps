[gd_scene load_steps=4 format=3]

[ext_resource type="Theme" path="res://theme/tactical_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://ui/profile_screen.gd" id="2_profile"]
[ext_resource type="Texture2D" path="res://assets/ui/avatar_default.png" id="3_avatar"]

[node name="ProfileScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = ExtResource("2_profile")

[node name="Columns" type="HBoxContainer" parent="."]
