[node name="Title" type="Label" parent="Center/Panel/Rows"]
layout_mode = 2
theme_type_variation = &"LabelTitle"
text = "你有一场没打完的对局"

[node name="MatchInfo" type="Label" parent="Center/Panel/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelMonoMuted"
text = "对局进行中"

[node name="Detail" type="Label" parent="Center/Panel/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelMuted"
text = "回到对局：接着打这一局，比分与战绩都还在。
放弃对局：只把你从这一局里释放出来 —— 本局不再计入你的战绩，对手那一局继续打完。"
autowrap_mode = 2

[node name="Divider" type="HSeparator" parent="Center/Panel/Rows"]
layout_mode = 2

[node name="Actions" type="HBoxContainer" parent="Center/Panel/Rows"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Abandon" type="Button" parent="Center/Panel/Rows/Actions"]
mouse_default_cursor_shape = 2
tooltip_text = "放弃这一局：你不再收帧、不再计入本局战绩；对手的对局不受影响"
